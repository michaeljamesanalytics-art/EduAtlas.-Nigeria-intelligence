function watTime(iso){if(!iso)return 'No successful check yet';try{return new Intl.DateTimeFormat('en-GB',{timeZone:'Africa/Lagos',dateStyle:'medium',timeStyle:'short',hour12:false}).format(new Date(iso))+' WAT'}catch(_){return iso}}
function currentStudy(){return A.tracks.flatMap(t=>t.lessons).find(x=>x.id===S.studyLesson)||A.tracks[0]?.lessons[0]}
function learning(){
 const total=A.tracks.reduce((n,t)=>n+t.lessons.length,0),finished=S.studyCompleted.length,percent=total?Math.round(100*finished/total):0;
 const track=A.tracks[S.track]||A.tracks[0],lesson=currentStudy();
 if(!track||!lesson)return '<div class="empty">Learning materials are unavailable. Check academy.js.</div>';
 const trackCompleted=t=>t.lessons.filter(x=>S.studyCompleted.includes(x.id)).length;
 const readings=(lesson.sources||[]).map(key=>A.sources.find(s=>s.id===key)).filter(Boolean);
 return `${heading('Systematic learning atlas','Understand Nigerian education from the ground up','Thirteen connected tracks, 65 source-guided lessons, learning checks and practical investigations. Begin with first principles; move through history, law, institutions, teaching, finance, technology and reform.')}<div class="card atlas-intro"><div class="row-between"><div><span class="eyebrow">YOUR STRUCTURED LEARNING JOURNEY</span><h3>${finished}/${total} lessons completed</h3></div>${badge(percent+'% complete')}</div><div class="progressbg"><div class="progressfill" style="width:${percent}%"></div></div><p>Use each lesson as a serious study note: read the explanation, examine Nigeria's application, follow the source, complete the investigation and check your reasoning. Progress and notes stay in this browser.</p></div><div class="track-scroller" aria-label="Choose a learning track">${A.tracks.map((t,i)=>`<button type="button" class="track-tab ${i===S.track?'active':''}" data-study-track="${i}"><span>${String(i+1).padStart(2,'0')} · ${e(t.title)}</span><small>${trackCompleted(t)}/${t.lessons.length} complete</small></button>`).join('')}</div><div class="study-grid"><aside class="study-sidebar"><div class="eyebrow">TRACK ${S.track+1} OF ${A.tracks.length}</div><h3>${e(track.title)}</h3><p>${e(track.purpose)}</p><div class="study-lesson-list">${track.lessons.map((l,i)=>`<button type="button" data-study-lesson="${attr(l.id)}" class="study-lesson ${S.studyLesson===l.id?'active':''}"><span class="study-num">${S.studyCompleted.includes(l.id)?'✓':String(i+1).padStart(2,'0')}</span><span>${e(l.title)}</span></button>`).join('')}</div><div class="side-aim"><b>Learning discipline</b><p>A completed lesson means you read and engaged with it; it does not certify mastery. Revisit lessons after consulting primary sources.</p></div></aside><article class="learning-article study-article"><div class="row-between"><div class="eyebrow">TRACK ${S.track+1} · LESSON ${lesson.number} · ${lesson.minutes} MIN STUDY</div>${badge(S.studyCompleted.includes(lesson.id)?'Completed':'In progress',S.studyCompleted.includes(lesson.id)?'':'gray')}</div><h2>${e(lesson.title)}</h2><div class="keytake"><b>01 — The idea</b><p>${e(lesson.foundation)}</p></div><h3>02 — How the system works</h3><p>${e(lesson.mechanism)}</p><h3>03 — Nigeria in practice</h3><p>${e(lesson.nigeria)}</p><h3>04 — Investigate and apply</h3><div class="question">${e(lesson.investigate)}</div><h3>05 — Check your understanding</h3><button class="btn light" data-study-answer="1">${S.showStudyAnswer?'Hide answer guide':'Reveal reasoning guide →'}</button>${S.showStudyAnswer?`<div class="answer-guide">${e(lesson.checkAnswer)}</div>`:''}<h3>Read the original source</h3><p>Source links are starting points. Verify the exact document, edition, publication date and relevant passage before quoting claims.</p><div class="study-sources">${readings.map(src=>source(src.url,src.title+' ↗')).join('')}</div><h3>Personal field notes</h3><textarea class="notes" id="studyNote" placeholder="In your own words: what did I learn, what remains uncertain, and which Nigerian institution should I examine?">${e(S.studyNotes[lesson.id]||'')}</textarea><div class="row-between study-bottom"><button class="btn" data-study-complete="${attr(lesson.id)}">${S.studyCompleted.includes(lesson.id)?'✓ Completed — undo':'Mark as studied ✓'}</button><button class="btn outline" data-study-next="1">Next lesson →</button></div></article></div><div class="notice warn" style="margin-top:18px"><strong>Scope:</strong> This is a comprehensive learning map and 65 substantial introductory study notes—not an exhaustive legal encyclopedia or automatically revised textbook. Documents and current officeholders require periodic source checks. Research the cited original documents for academic or policy use.</div>`
}
function glossary(){const arr=A.glossary.filter(g=>matches(g.term,g.definition));return `${heading('Definitions and concepts','Education system glossary','A searchable dictionary of major education, public-finance, teaching, data and evaluation terms. The meanings below are concise study definitions; follow linked lessons for the deeper mechanisms.')}<div class="notice" style="margin-bottom:16px">${A.glossary.length} foundational terms · Search using the box at the top of the page.</div><div class="grid two">${arr.map(g=>`<div class="card gloss-card"><h3>${e(g.term)}</h3><p>${e(g.definition)}</p></div>`).join('')||'<div class="empty">No matching definitions. Try another phrase.</div>'}</div>`}
function system(){return `${heading('Institutional systems map','Who controls what in Nigerian education?','A guided authority map. Always verify the exact mandate for the programme you are researching; institutions do not form one simple national command chain.')}<div class="card"><div class="eyebrow">THE FIVE QUESTIONS</div><div class="chain">${[['Rule','Who has lawful authority?'],['Money','Who appropriates and releases?'],['Delivery','Who actually implements?'],['Monitoring','Who inspects and measures?'],['Remedy','Who can fix a failure?']].map((x,i)=>`${i?'<span class="arrow">›</span>':''}<div class="node"><strong>${x[0]}</strong><small>${x[1]}</small></div>`).join('')}</div></div>${section('Levels of responsibility','','A conceptual guide—actual duties vary across education subsectors')}<div class="grid two">${[['Federal policy and coordination','FME and national bodies create policy, establish some standards, manage federal institutions and coordinate selected national programmes.','Policy and national strategy'],['Basic education implementation','State ministries, SUBEBs, local education authorities, school heads and teachers handle major aspects of classroom delivery.','Teacher deployment and facilities'],['Curriculum and assessment','NERDC, examination bodies and quality assurance systems interact, but curriculum authors do not personally teach every lesson.','Subject content and achievement'],['Tertiary and technical regulation','NUC, NBTE, NCCE and other bodies have distinct statutory or administrative roles, depending on institution and programme.','Accreditation and training standards'],['Education financing','Federal and state budgets, UBEC interventions, TETFund, student financing, donor programmes and households fund different things.','Approvals, releases and audits'],['Evidence and public oversight','School census systems, inspectors, independent researchers, civil society, parents and legislative bodies contribute distinct evidence and scrutiny.','Learning outcomes and accountability']].map(x=>`<div class="card"><div class="eyebrow">${x[2]}</div><h3>${x[0]}</h3><p>${x[1]}</p></div>`).join('')}</div>${section('Follow a specific case')}<div class="card"><h3>Why is a primary school missing mathematics teachers?</h3><p>Start at the school and relevant state/local education authorities; verify teacher numbers, vacancies, budgeted posts and recruitment rules. Check whether federal or state programmes were involved. Ask the authority with the actual mandate for recruitment and deployment; track what it has done. Do not assume the Federal Minister appoints that school's teachers.</p><div style="margin-top:15px">${nav('power','Explore institutions and leaders →')}&nbsp;${nav('money','Follow spending evidence →','btn light')}</div></div>`}
function daily(){
 const B=S.daily||{};const state=B.feed_health||'awaiting deployment';const health=state==='healthy'?'Source check succeeded':state==='partial'?'Some sources failed':state==='unavailable'?'No source check succeeded':'Scheduled feeds not deployed';
 const checked=B.last_successful_check_utc;const recent=(B.recent_unreviewed_discoveries||[]).slice(0,8);
 return `${heading('7:00 AM West Africa Time','The daily education intelligence desk','Every morning: discover what agencies published, surface what needs verification, and learn how the development fits into Nigerian education policy and accountability.')}<div class="grid three"><div class="stat-card"><div class="top">Target update window</div><div class="num">07:00</div><div class="foot">Daily · Africa/Lagos · UTC+1</div></div><div class="stat-card"><div class="top">Last successful source check</div><div class="num" style="font-size:15px;line-height:1.5">${e(watTime(checked))}</div><div class="foot">Actual check timestamp, not article publication</div></div><div class="stat-card"><div class="top">Status</div><div class="num" style="font-size:16px">${e(health)}</div><div class="foot">${e(B.sources_succeeded?.length||0)} sources reached; ${e(B.sources_failed?.length||0)} failed</div></div></div><div class="notice ${state==='healthy'?'':'warn'}" style="margin-top:18px"><strong>Freshness disclosure:</strong> ${e(B.coverage_note||'No live source checks recorded yet.')} ${!checked?'This offline/downloadable version cannot run scheduled network requests on its own.':''} GitHub Actions scheduling is best-effort, not a guaranteed 7:00 AM service-level deadline.</div>${section('Latest automatically discovered items','', 'Unreviewed headlines: verify the original before drawing conclusions')}<div class="update-list">${recent.length?recent.map(u=>`<div class="update" style="grid-template-columns:54px minmax(0,1fr)"><div class="u-date"><b>${e(u.date.slice(8))}</b><small>${e(month(u.date))}</small></div><div>${badge('UNREVIEWED','gold')} <span class="tiny">${e(u.agency)} · ${e(u.topic)}</span><div class="u-title">${e(u.headline)}</div>${source(u.url,'Open original publication ↗')}</div></div>`).join(''):`<div class="empty">No recent discoveries in the published feed. This does <b>not</b> mean there was no education news nationally. Continue with sourced, curated items below.</div>`}</div>${section('Curated context','', 'Established source records, not automatically new today')}<div class="update-list">${D.updates.slice(0,4).map(updateRow).join('')}</div>${section('Agency connectivity and limitations')}<div class="grid two"><div class="card"><h3>Sources successfully reached</h3>${(B.sources_succeeded||[]).length?(B.sources_succeeded||[]).map(x=>`<p>${e(x.source)} · ${e(x.entries)} parsed records</p>`).join(''):'<p>Awaiting the first hosted scheduled check.</p>'}</div><div class="card"><h3>Sources that need attention</h3>${(B.sources_failed||[]).length?(B.sources_failed||[]).map(x=>`<p>${e(x.source)} · ${e(x.error)}</p>`).join(''):'<p>No failures reported in the latest completed check, or no check has run yet.</p>'}</div></div><div class="notice warn" style="margin-top:16px"><b>Daily insight ≠ comprehensive monitoring.</b> The provided pipeline currently polls a selected set of federal RSS feeds (FME, UBEC, NUC). It does not automatically cover every Nigerian state, institution, appointment, expenditure or policy outcome.</div>`
}
